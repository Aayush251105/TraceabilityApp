              "tag": "C1",
              "quote": "def recommend(self, book_name: str):\n    try:\n        if book_name not in self.book_pivot.index:\n            logger.warning(f\"Book title '{book_name}' not found in pivot table index.\")\n            return [], []\n        # Locate row index of book_name\n        book_id = np.where(self.book_pivot.index == book_name)[0][0]\n        # Find 6 nearest neighbors (1st neighbor is the query book itself)\n        distances, suggestions = self.model.kneighbors(\n            self.book_pivot.iloc[book_id, :].values.reshape(1, -1),\n            n_neighbors=6\n        )\n        recommended_books = []\n        poster_urls = []\n        default_poster = \"https://images.amazon.com/images/P/059035342X.01.MZZZZZZZ.jpg\"\n        for i in range(len(suggestions[0])):\n            idx = suggestions[0][i]\n            title = self.book_pivot.index[idx]\n            # Skip the input query book itself\n            if title == book_name and i == 0:\n                continue\n            recommended_books.append(title)\n            # Fetch image URL from final_rating dataset\n            matching_items = self.final_rating[self.final_rating['title'] == title]\n            if not matching_items.empty and 'image_url' in matching_items.columns:\n                url = matching_items.iloc[0]['image_url']\n                poster_urls.append(url if isinstance(url, str) and url.startswith(\"http\") else default_poster)\n            else:\n                poster_urls.append(default_poster)\n        return recommended_books[:5], poster_urls[:5]\n    except Exception as e:\n        raise CustomException(e, sys)",
